<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ivory: a quiet syntax theme for claude-academic. Clay keywords, olive strings, sky constants. -->
<plist version="1.0">
<dict>
  <key>name</key>
  <string>Ivory</string>
  <key>settings</key>
  <array>
    <dict>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#141413</string>
        <key>background</key>
        <string>#F0EEE6</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Comment</string>
      <key>scope</key>
      <string>comment, punctuation.definition.comment</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#87857C</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Keyword</string>
      <key>scope</key>
      <string>keyword, storage, storage.modifier, keyword.control, keyword.operator.word</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#B9532F</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>String</string>
      <key>scope</key>
      <string>string, string.quoted, markup.raw</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#5C6F40</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Constant</string>
      <key>scope</key>
      <string>constant, constant.numeric, constant.language, constant.character, support.constant</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#3D6C9C</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Type</string>
      <key>scope</key>
      <string>entity.name.type, entity.name.class, support.type, support.class, storage.type</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#9A4563</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Function</string>
      <key>scope</key>
      <string>entity.name.function, support.function, meta.function-call variable.function</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#141413</string>
        <key>fontStyle</key>
        <string>bold</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Decorator / tag</string>
      <key>scope</key>
      <string>entity.name.tag, meta.decorator, entity.name.function.decorator, punctuation.definition.decorator</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#B9532F</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Parameter / attribute</string>
      <key>scope</key>
      <string>variable.parameter, entity.other.attribute-name</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#3D3D3A</string>
        <key>fontStyle</key>
        <string>italic</string>
      </dict>
    </dict>
    <dict>
      <key>name</key>
      <string>Invalid</string>
      <key>scope</key>
      <string>invalid</string>
      <key>settings</key>
      <dict>
        <key>foreground</key>
        <string>#B9532F</string>
        <key>fontStyle</key>
        <string>underline</string>
      </dict>
    </dict>
  </array>
</dict>
</plist>
